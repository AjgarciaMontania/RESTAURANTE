rules_version = '2';

// Reglas de seguridad de Firestore para el sistema del restaurante.
//
// Cómo aplicarlas:
//   Firebase Console -> Firestore Database -> pestaña "Reglas"
//   -> pegar esto -> Publicar
//
// Requisito previo:
//   Firebase Console -> Authentication -> Sign-in method
//   -> habilitar el proveedor "Anónimo"
//
// Qué logran:
//   - Nadie puede leer ni escribir en la base desde fuera de la app.
//   - El PIN de acceso (config/acceso) se guarda solo como hash SHA-256,
//     nunca en texto plano, y no se puede borrar desde la app.

service cloud.firestore {
  match /databases/{database}/documents {

    function appIniciada() {
      return request.auth != null;
    }

    // Menú del día: menus/2026-08-17
    match /menus/{fecha} {
      allow read, write: if appIniciada();
    }

    // Pedidos del talonario.
    // Se permite borrar: un pedido mal montado se elimina desde Caja, que solo
    // abre el administrador con su PIN.
    match /pedidos/{pedido} {
      allow read, create, update, delete: if appIniciada();
    }

    // Consecutivo diario
    match /contadores/{fecha} {
      allow read, write: if appIniciada();
    }

    // Clientes que fían y sus movimientos de cuenta
    match /clientes/{cliente} {
      allow read, write: if appIniciada();
    }
    match /fiados/{movimiento} {
      allow read, write: if appIniciada();
    }

    // Precios base y plantillas de los mensajes de WhatsApp
    match /config/precios {
      allow read, write: if appIniciada();
    }
    match /config/mensajes {
      allow read, write: if appIniciada();
    }

    // PIN de acceso (solo el hash)
    match /config/acceso {
      allow read, write: if appIniciada();
      allow delete: if false;
    }

    // Todo lo demás queda cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
